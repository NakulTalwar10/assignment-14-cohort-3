# Local MongoDB for development. In production use MongoDB Atlas, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
dbName=small_ecommerce
PORT=5000
NODE_ENV=development

# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string

# Comma-separated list of extra origins allowed to call the API (same-origin requests are always allowed)
CLIENT_URL=http://localhost:5173
COOKIE_SAME_SITE=strict
# Number of proxies in front of Express. Defaults to 1 automatically on Vercel.
TRUST_PROXY=
LOGIN_RATE_LIMIT_MAX=10
